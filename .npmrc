# NPM configuration for Railway deployment
# Python path for node-gyp compilation
python=/usr/bin/python3

# SQLite prebuilt binaries for better-sqlite3
better_sqlite3_binary_host_mirror=https://registry.npmmirror.com/-/binary/better-sqlite3/
better_sqlite3_binary_site=https://registry.npmmirror.com/-/binary/better-sqlite3/

# SQLite3 prebuilt binaries (fallback)
sqlite3_binary_host_mirror=https://foxgis.oss-cn-shanghai.aliyuncs.com/
sqlite3_binary_site=https://foxgis.oss-cn-shanghai.aliyuncs.com/

# Node-gyp configuration
node_gyp=$(npm config get prefix)/lib/node_modules/npm/node_modules/node-gyp/bin/node-gyp.js
