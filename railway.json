{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "buildCommand": "docker build -t web-marbles ."
  },
  "deploy": {
    "startCommand": "node dist/web-marbles.js",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "env": {
      "NODE_ENV": "production"
    }
  },
  "volumes": [
    {
      "name": "marbles-data",
      "path": "/app/data"
    }
  ]
}
